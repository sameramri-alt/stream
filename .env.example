# ============================================================

# FICHIER .env — Variables de configuration du projet

# NE PAS PARTAGER CE FICHIER SUR GITHUB (ajouter au .gitignore)

# ============================================================



# --- MinIO (Stockage S3 local) ---

MINIO_ROOT_USER=minioadmin

MINIO_ROOT_PASSWORD=minioadmin123

MINIO_ENDPOINT=http://minio:9000



# --- Redpanda (Message Broker) ---

REDPANDA_BROKERS=redpanda:9092

KAFKA_TOPIC=wikimedia-raw



# --- Wikipedia SSE Source ---

WIKIMEDIA_SSE_URL=https://stream.wikimedia.org/v2/stream/recentchange



# --- Spark ---

SPARK_MASTER_URL=spark://spark-master:7077



# --- Chemins Delta Lake dans MinIO ---

BRONZE_PATH=s3a://lakehouse/bronze/wikimedia_events/

SILVER_PATH=s3a://lakehouse/silver/wikimedia_cleaned/

GOLD_TOP_PATH=s3a://lakehouse/gold/top_articles/

GOLD_METRICS_PATH=s3a://lakehouse/gold/metrics_by_wiki/

CHECKPOINT_PATH=s3a://lakehouse/checkpoints/

# --- Nouveaux chemins Gold (Améliorations) ---

GOLD_LANG_PATH=s3a://lakehouse/gold/edits_by_language/

GOLD_TIMESERIES_PATH=s3a://lakehouse/gold/edits_timeseries/
